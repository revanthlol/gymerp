# ==============================================================================
# GymERP Environment Configuration Template
# Copy to .env.local for development: cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# App Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16 via Docker or Hosted VM)
# ------------------------------------------------------------------------------
POSTGRES_USER=gymerp
POSTGRES_PASSWORD=gymerp_secret_dev_pass
POSTGRES_DB=gymerp
POSTGRES_PORT=5432
DATABASE_URL="postgresql://gymerp:gymerp_secret_dev_pass@localhost:5432/gymerp?sslmode=disable"

# ------------------------------------------------------------------------------
# Firebase Client SDK (Web App Configuration)
# Obtain from Firebase Console > Project Settings > General > Your Apps > SDK setup/config
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="gymerp-dev.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="gymerp-dev"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="gymerp-dev.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Server Actions & Route Handlers)
# Obtain from Firebase Console > Project Settings > Service accounts > Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="gymerp-dev"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@gymerp-dev.iam.gserviceaccount.com"
# Note: Escape newlines if passing directly as a string or format with standard multi-line RSA PEM
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Session Cookie Configuration
# Used by Next.js Server Components & Middleware for Auth verification
# ------------------------------------------------------------------------------
SESSION_COOKIE_NAME="__session"
# Session duration in seconds (e.g., 5 days = 432000 seconds)
SESSION_COOKIE_EXPIRES_IN=432000

# ------------------------------------------------------------------------------
# Payment Gateway (Abstracted - Razorpay default)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_SECRET="YourTestKeySecret"
RAZORPAY_WEBHOOK_SECRET="YourTestWebhookSecret"
